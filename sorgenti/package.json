{
  "name": "nido",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "mobile": "npm run start --workspace @nido/mobile",
    "web": "npm run web --workspace @nido/mobile",
    "admin": "npm run dev --workspace @nido/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:admin": "npm run build --workspace @nido/admin",
    "build:mobile": "npm run export --workspace @nido/mobile",
    "build:web": "npm run export:web --workspace @nido/mobile && node scripts/prepare-web.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
